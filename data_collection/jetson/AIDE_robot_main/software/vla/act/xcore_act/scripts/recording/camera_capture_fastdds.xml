<?xml version="1.0" encoding="UTF-8"?>
<!-- Applied only to the teaching collector's camera launch, never globally.
     RGB VGA messages are ~0.92 MB; the default 512 KiB SHM segment is too small.
     Keep UDPv4 for discovery and communication with other machines.
     https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/transport/shared_memory/shared_memory.html
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>aide_camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>aide_camera_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="aide_camera_large_data" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>aide_camera_shm</transport_id>
        <transport_id>aide_camera_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
