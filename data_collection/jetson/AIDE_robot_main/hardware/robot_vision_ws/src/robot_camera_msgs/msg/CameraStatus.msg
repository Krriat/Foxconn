# 单台相机的运行时健康状态。
# 由 camera_manager 在线监测后发布，下游（任务规划/导航/抓取）可订阅
# 据此决策，例如头部相机掉线时暂停抓取任务。
#
# 发布建议：
#   话题 /robot/vision/camera_status  单台状态（每次一台）
#   频率 1~5 Hz

# =========================================================================
# 状态枚举
# =========================================================================
uint8 STATE_UNKNOWN = 0   # 启动中，尚未采集到任何数据
uint8 STATE_OK      = 1   # 节点存活且所有启用的流都在按预期出图
uint8 STATE_STALE    = 2   # 节点存活但某条流 N 秒无新数据
uint8 STATE_OFFLINE  = 3   # 相机驱动节点不存在 / 未启动
uint8 STATE_ERROR    = 4   # 节点存活但报错，或深度比例与配置不一致

# =========================================================================
# 标准头
# =========================================================================
std_msgs/Header header
#   header.stamp       本条状态生成时间
#   header.frame_id    通常留空，状态不属于某个 TF frame

# =========================================================================
# 相机身份（对应 cameras.yaml 中的字段，便于订阅方无需再查 YAML）
# =========================================================================
string camera_id            # YAML 中 cameras 下的 key，如 "head"
string camera_name          # camera_name 字段
string model                # "D435i" / "D405"
string semantic_location   # "head" / "left_wrist" / "chest"

# =========================================================================
# 主结论
# =========================================================================
uint8 state                 # 见上方枚举常量
string detail               # 可补充，如 "color stream stale for 3.2s"

# =========================================================================
# 流级健康（一台相机可能彩色正常但深度掉线）
# =========================================================================
bool color_stream_ok        # color/image_raw 是否在发
bool depth_stream_ok        # depth/image_rect_raw 是否在发
bool aligned_depth_ok       # aligned_depth_to_color/image_raw 是否在发

# =========================================================================
# 帧率与新鲜度指标
# =========================================================================
float32 last_hz             # 最近窗口测得的彩色图帧率，无数据时为 0
float32 last_seen_age_sec   # 距任一已启用流最新一帧的秒数；从未收到为 -1.0

# =========================================================================
# 深度比例一致性校验
# =========================================================================
float32 expected_scale_m_per_unit   # cameras.yaml 中配置的 depth.scale_m_per_unit
float32 measured_scale_m_per_unit   # 从设备 API 实测；未实测时为 0
                                    # 实测后与期望值不一致 → STATE_ERROR
