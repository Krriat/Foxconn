# 按需查询某台相机的完整资料：身份 / 内参 / 外参 / 深度比例 / 当前状态 / 话题路径 / TF frame。
# 与 robot_camera_msgs/CameraStatus 话题互补：
#   话题推健康（2 Hz 周期广播），服务拉完整资料（按需同步一问一答）。
#
# 调用示例：
#   ros2 service call /robot/vision/get_camera_info robot_camera_msgs/srv/GetCameraInfo "{camera_id: 'head'}"

# ============================ 请求 ============================
string camera_id            # cameras.yaml 中的 key，如 "head"
                            # 空串或不存在的 id → exists=false

---

# ============================ 响应 ============================
# ---- 身份 ----
string camera_id
string camera_name
string model
string semantic_location
bool exists                 # 该 camera_id 是否在 cameras.yaml 中（且 enabled=true）

# ---- 内参（优先 aligned depth，否则 color/depth CameraInfo）----
float64[9] k                # 3x3 内参矩阵，行优先；未收到时全 0
float64[] d                 # 畸变系数；未收到时空
uint32 width                # 图像宽；未收到时为 0
uint32 height               # 图像高；未收到时为 0
bool intrinsics_available   # 是否已收到过 camera_info

# ---- 外参（相机→base_link）----
float64[16] t_cam2base      # 4x4 齐次变换，行优先
                            # camera_manager 暂不持有外参，返回全 0 +
                            # extrinsics_available=false，待外参标定结果接入
bool extrinsics_available   # 是否有有效外参

# ---- 深度 ----
float32 depth_scale_m_per_unit   # cameras.yaml 配置的 depth.scale_m_per_unit

# ---- 当前健康状态（取值见 CameraStatus.msg 的 STATE_* 常量）----
uint8 state
string detail
float32 last_hz
float32 last_seen_age_sec

# ---- 话题路径（绝对）----
string color_topic
string depth_topic
string aligned_depth_topic
string aligned_depth_info_topic

# ---- TF frame 名 ----
string color_optical_frame
string depth_optical_frame
string base_frame
